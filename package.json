{
	"name": "node-mac-recorder",
	"version": "2.24.28",
	"description": "Native macOS screen recording package for Node.js applications",
	"main": "index.js",
	"files": [
		"index.js",
		"index-multiprocess.js",
		"recorder-worker.js",
		"recorder_runtime_safety.cjs",
		"MultiWindowRecorder.js",
		"window-selector.js",
		"electron-safe-index.js",
		"install.js",
		"binding.gyp",
		"scripts/native-build.cjs",
		"build-electron-safe.js",
		"electron-safe-binding.gyp",
		"src/",
		"!src/**/*backup*",
		"!src/**/*.tmp",
		"!src/screen_capture_kit_new.mm",
		"!src/screen_capture_kit_simple.mm"
	],
	"keywords": [
		"macos",
		"screen",
		"recording",
		"capture",
		"video",
		"native",
		"electron"
	],
	"author": "aslanonur",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aslanon/node-mac-recorder.git"
	},
	"homepage": "https://creavit.studio/open-source-screen-recorder",
	"bugs": {
		"url": "https://github.com/aslanon/node-mac-recorder/issues"
	},
	"engines": {
		"node": ">=14.0.0"
	},
	"os": [
		"darwin"
	],
	"cpu": [
		"x64",
		"arm64"
	],
	"scripts": {
		"test": "node test.js",
		"test:cursor": "node --test tests/cursor-detection.test.cjs",
		"test:cursor:electron": "node --test tests/cursor-electron.test.cjs",
		"install": "node install.js",
		"build": "node scripts/native-build.cjs build",
		"rebuild": "node scripts/native-build.cjs rebuild",
		"clean": "node scripts/native-build.cjs clean",
		"test:window-selector": "node window-selector-test.js",
		"example:window-selector": "node examples/window-selector-example.js",
		"build:electron-safe": "node build-electron-safe.js",
		"test:electron-safe": "node test-electron-safe.js",
		"clean:electron-safe": "node scripts/native-build.cjs clean",
		"canvas": "node make-canvas.js"
	},
	"dependencies": {
		"node-addon-api": "^7.0.0"
	},
	"devDependencies": {
		"node-gyp": "^10.0.0"
	},
	"gypfile": true
}
